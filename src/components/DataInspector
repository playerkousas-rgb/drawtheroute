import React from 'react';
// 這裡的引進路徑，我改為相對路徑，請確保檔案在 src/hooks/useItineraryData.ts
import { useItineraryData } from '../hooks/useItineraryData';

/**
 * 我們這裡的 Props 名稱，嚴格對齊你在 App.tsx 傳進來的名字
 */
export default function DataInspector({ waypoints, segments, naismithSettings }: any) {
  
  // 我們將傳進來的 naismithSettings 給大總管處理
  const { materials, weather } = useItineraryData(
    waypoints, 
    segments, 
    naismithSettings
  );

  if (!waypoints || waypoints.length === 0) {
    return (
      <div className="fixed bottom-4 left-4 z-[2000] bg-slate-900 p-4 rounded-lg border border-slate-700 text-slate-400 text-xs font-mono">
        等待地圖點位輸入...
      </div>
    );
  }

  return (
    <div className="fixed bottom-4 left-4 z-[2000] bg-slate-900/95 text-emerald-400 p-4 rounded-xl border border-emerald-500/30 shadow-2xl font-mono text-[10px] w-[500px] max-h-[300px] overflow-auto">
      <h2 className="text-white border-b border-slate-700 pb-2 mb-2 flex justify-between">
        <span>🧪 材料加工驗收儀</span>
        <span className="text-slate-500">點位總數: {waypoints.length}</span>
      </h2>

      <div className="space-y-4">
        {/* 驗收天氣 */}
        <div className="flex gap-4 items-center bg-slate-800/50 p-2 rounded">
          <span className="text-slate-400">🌦️ 起點天氣:</span>
          {weather ? (
            <span className="text-blue-300">{weather.temp}°C / {weather.description}</span>
          ) : (
            <span className="text-slate-600 italic">獲取中...</span>
          )}
        </div>

        {/* 驗收點位加工 */}
        <table className="w-full text-left">
          <thead className="text-slate-500 border-b border-slate-800">
            <tr>
              <th>ID</th>
              <th>KK Grid (網格)</th>
              <th>Alt (高度)</th>
              <th>Bearing (方位)</th>
            </tr>
          </thead>
          <tbody>
            {materials.map((m: any, i: number) => (
              <tr key={i} className="border-b border-slate-800/50">
                <td className="py-1 text-white">{m.id}</td>
                <td className="py-1 text-blue-400">{m.grid}</td>
                <td className="py-1 text-emerald-500">{m.ele.toFixed(0)}m</td>
                <td className="py-1 text-yellow-500">{m.bearing !== null ? `${m.bearing}°` : '--'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
