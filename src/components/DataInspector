import React from 'react';
import { useItineraryData } from '../hooks/useItineraryData';

// 這裡接收來自 App.tsx 的所有原始材料
export default function DataInspector({ waypoints, segments, naismithSettings }: any) {
  
  // 呼叫我們剛才寫好的「大總管」Hook，進行加工
  const { materials, weather, settings } = useItineraryData(
    waypoints, 
    segments, 
    naismithSettings
  );

  return (
    <div className="fixed bottom-0 left-0 w-full z-[9999] bg-black/90 text-green-400 p-4 font-mono text-[10px] border-t-2 border-green-500 max-h-[40vh] overflow-auto">
      <div className="flex justify-between items-center mb-2 border-b border-green-900 pb-1">
        <h2 className="text-white font-bold">🛠️ 數據加工廠驗收儀 (Raw Materials Test)</h2>
        <div className="flex gap-4">
          <span>天氣狀態: {weather ? '✅ 已連通' : '❌ 未連通'}</span>
          <span>右側欄同步: {settings ? '✅ 已同步' : '❌ 斷開'}</span>
        </div>
      </div>

      <div className="grid grid-cols-3 gap-4">
        {/* 第一欄：氣象與參數驗收 */}
        <div className="border-r border-green-900/50 pr-2">
          <h3 className="text-blue-400 mb-1 underline">1. 外部服務數據</h3>
          <pre className="text-[9px]">
            {weather ? JSON.stringify({
              temp: `${weather.temp}°C`,
              wind: `${weather.windSpeed}km/h`,
              sun: `${weather.sunrise}/${weather.sunset}`
            }, null, 2) : '等待數據...'}
          </pre>
          <h3 className="text-violet-400 mt-2 mb-1 underline">2. Naismith 參數</h3>
          <p>時速: {settings?.baseSpeedKmh} km/h</p>
          <p>上升加時: {settings?.ascentPer20m} min</p>
        </div>

        {/* 第二及第三欄：行程點計算驗收 */}
        <div className="col-span-2">
          <h3 className="text-amber-400 mb-1 underline">3. 行程點加工結果 (Waypoints Processed)</h3>
          <table className="w-full text-left">
            <thead>
              <tr className="text-slate-500 border-b border-slate-800">
                <th>標記</th>
                <th>KK 網格</th>
                <th>高度</th>
                <th>方位</th>
                <th>累積距離</th>
                <th>預計到達</th>
              </tr>
            </thead>
            <tbody>
              {materials.map((m: any, i: number) => (
                <tr key={i} className="border-b border-slate-900">
                  <td className="text-white">{m.id}</td>
                  <td className="text-blue-300">{m.grid}</td>
                  <td className="text-emerald-300">{m.ele.toFixed(0)}m</td>
                  <td className="text-yellow-500">{m.bearing ?? '--'}°</td>
                  <td className="text-purple-400">{m.accDist.toFixed(2)}km</td>
                  <td className="text-orange-400 font-bold">{m.predictedArrival}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
